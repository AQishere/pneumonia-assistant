# Copy to .env.local and fill in.

# FastAPI backend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Firebase web app config (public by design). Firebase console:
# Project settings -> General -> Your apps -> Add app (Web) -> copy these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pneuomnia-assistant.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pneuomnia-assistant
NEXT_PUBLIC_FIREBASE_APP_ID=
