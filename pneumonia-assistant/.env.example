# Copy to .env and fill in. Never commit .env.

# Shared secret for the FastAPI server's X-API-Key header (any long random string).
API_KEY=change-me
API_URL=http://127.0.0.1:8000

# Web app origin(s) allowed to call the API (comma-separated).
FRONTEND_ORIGINS=http://localhost:3000

# Stage 2 model file in models/ (default: stage2_v2.joblib; stage2.joblib is the original model).
# STAGE2_MODEL=stage2_v2.joblib

# Storage: "firestore" (real) or "memory" (demo without Firebase; seeds demo patients on start).
DB_BACKEND=memory
SEED_DEMO=1
# Path to the Firebase service-account JSON (Firestore only).
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# LLM for the agent: Gemini. List current models with: python -m agent.chat --list-models
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# LLM_REASONING_EFFORT=  # optional: low / medium / high
